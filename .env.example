# Copy this file to .env and fill in real values before running docker-compose.
# Never commit .env to git.

# Shared API key between the Spring Boot backend and the FastAPI ML service.
# Use any strong random string in production.
CVD_ML_API_KEY=your_ml_api_key_here

# Secret used to sign JWT tokens — must be at least 32 characters.
CVD_JWT_SECRET=your_jwt_secret_at_least_32_chars_here

# PostgreSQL credentials (only needed for local dev without Docker).
# Docker Compose uses the defaults defined in docker-compose.yml.
DB_USERNAME=postgres
DB_PASSWORD=
